{
  "id": "aimlapi",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": ["aimlapi"],
  "providerEndpoints": [
    {
      "endpointClass": "aimlapi-public",
      "hosts": ["api.aimlapi.com"]
    }
  ],
  "setup": {
    "providers": [
      {
        "id": "aimlapi",
        "authMethods": ["api-key"],
        "envVars": ["AIMLAPI_API_KEY"]
      }
    ]
  },
  "providerAuthChoices": [
    {
      "provider": "aimlapi",
      "method": "api-key",
      "choiceId": "aimlapi-api-key",
      "choiceLabel": "AI/ML API key",
      "choiceHint": "One API key for multiple model families",
      "groupId": "aimlapi",
      "groupLabel": "AI/ML API",
      "groupHint": "OpenAI-compatible multi-model inference",
      "optionKey": "aimlapiApiKey",
      "cliFlag": "--aimlapi-api-key",
      "cliOption": "--aimlapi-api-key <key>",
      "cliDescription": "AI/ML API key"
    }
  ],
  "modelCatalog": {
    "providers": {
      "aimlapi": {
        "baseUrl": "https://api.aimlapi.com/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "openai/gpt-5-chat",
            "name": "GPT-5 Chat",
            "reasoning": true,
            "input": ["text", "image"],
            "contextWindow": 400000,
            "maxTokens": 16384,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "openai/gpt-4o-mini",
            "name": "GPT-4o Mini",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 128000,
            "maxTokens": 16384,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "anthropic/claude-sonnet-4.5",
            "name": "Claude 4.5 Sonnet",
            "reasoning": true,
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 64000,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "google/gemini-2.5-flash",
            "name": "Gemini 2.5 Flash",
            "reasoning": true,
            "input": ["text", "image"],
            "contextWindow": 1000000,
            "maxTokens": 65536,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "google/gemini-3-flash-preview",
            "name": "Gemini 3 Flash Preview",
            "reasoning": true,
            "input": ["text", "image"],
            "contextWindow": 1000000,
            "maxTokens": 65536,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          }
        ]
      }
    },
    "discovery": {
      "aimlapi": "static"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
