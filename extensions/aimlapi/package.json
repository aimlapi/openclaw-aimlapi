{
  "name": "@aimlapi/openclaw-provider",
  "version": "1.0.1",
  "description": "AI/ML API model provider plugin for OpenClaw.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aimlapi/openclaw-aimlapi"
  },
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:@aimlapi/openclaw-provider",
      "npmSpec": "@aimlapi/openclaw-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.11"
    },
    "compat": {
      "pluginApi": ">=2026.6.11"
    },
    "build": {
      "openclawVersion": "2026.6.11",
      "bundledDist": true
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
